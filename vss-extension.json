{
  "manifestVersion": 1,
  "id": "md-commenter-pr",
  "publisher": "ranplan",
  "version": "0.2.0",
  "name": "MD Commenter",
  "description": "Adds an 'MD Commenter' tab to Pull Requests: read Markdown files rendered, click any paragraph, list item, table row or code block and leave a PR comment anchored to the exact source lines.",
  "public": false,
  "categories": ["Azure Repos"],
  "tags": ["markdown", "pull request", "code review", "preview", "comments"],
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "icons": { "default": "img/logo.png" },
  "content": {
    "details": { "path": "README.md" },
    "license": { "path": "LICENSE.txt" }
  },
  "links": {
    "support": { "uri": "https://github.com/ranplan-wireless/md-commenter" },
    "license": { "uri": "https://github.com/ranplan-wireless/md-commenter/blob/main/LICENSE.txt" },
    "repository": { "uri": "https://github.com/ranplan-wireless/md-commenter" }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/ranplan-wireless/md-commenter"
  },
  "scopes": ["vso.code", "vso.threads_full"],
  "files": [
    { "path": "dist", "addressable": true },
    { "path": "img", "addressable": true }
  ],
  "contributions": [
    {
      "id": "md-commenter-pr-tab",
      "type": "ms.vss-web.tab",
      "description": "Rendered Markdown review tab for pull requests",
      "targets": ["ms.vss-code-web.pr-tabs"],
      "properties": {
        "name": "MD Commenter",
        "uri": "dist/tab.html",
        "registeredObjectId": "md-commenter-pr-tab"
      }
    }
  ]
}
